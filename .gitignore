# Build and local tooling
dist/
*.luac
node_modules/

# Editors
.idea/
*.swp
.DS_Store

# Local server configuration: contains credentials. acl.jsonc is also where the grants for
# a resource's restricted commands live -- the file that decides who may run them -- so it
# never belongs in a repository either.
server.jsonc
acl.jsonc
.env

# Agent tooling: 16 MB of skills, two of them nested git repos
.claude/

# Dev only, and only where a preview exists. preview.html is generated by
# tools/build-preview.py, weighs half a megabyte because the still is embedded as a data
# URI, and would land in a diff on every regeneration: the generator is what belongs in the
# repository, its output is one command away. The still it embeds is somebody else's
# screenshot, so it is ignored too -- point the generator at your own by dropping a JPEG
# there under the same name.
preview.html
tools/preview-bg.jpg
